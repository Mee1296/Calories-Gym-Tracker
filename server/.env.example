# Copy to .env and fill in. Never commit the real file.

NODE_ENV=development
PORT=5000

# Postgres connection string.
# Local (docker compose): postgresql://stride:stride-local-dev@localhost:5432/stride
# Supabase: Project Settings -> Database -> Connection string -> Session pooler.
#   Use the session pooler on :5432 for a long-running server.
#   The transaction pooler on :6543 also works — the driver detects it by port
#   and turns prepared statements off, which costs an extra round trip per query.
DATABASE_URL=postgresql://stride:stride-local-dev@localhost:5432/stride
DB_POOL_SIZE=10

# Required in production — the server refuses to boot without it.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Only needed to run the one-off Mongo -> Postgres import (npm run migrate).
MONGO_URI=

# Optional. Without a key the AI endpoints return 503 and the UI hides those tabs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=*
